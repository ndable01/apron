# Copy to relay/.env (it is ignored by git) and fill in. Never commit the key.
# PROVIDER: anthropic, openai or gemini. MODEL: the provider's exact model id.
PROVIDER=
MODEL=
API_KEY=
ALLOWED_ORIGINS=https://ndable01.github.io,http://localhost:8000,http://127.0.0.1:8000
RATE_PER_MIN=30
DAILY_LIMIT=500
MODEL_TIMEOUT_MS=9000
MAX_TOKENS=800
# Optional, sent only when set. EFFORT: reasoning level if the model has one (for example low).
EFFORT=
TEMPERATURE=
# Optional base URL, for an OpenAI-compatible gateway or a proxy.
API_BASE=
PORT=8787
# Set to 1 only behind your own reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
